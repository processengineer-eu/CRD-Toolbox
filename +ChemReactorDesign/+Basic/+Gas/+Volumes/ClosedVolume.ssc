import ChemReactorDesign.Basic.enum.*;
import ChemReactorDesign.Basic.Functions.*;
import ChemReactorDesign.Basic.Gas.enum.*;
import ChemReactorDesign.Basic.Gas.Functions.*;
import ChemReactorDesign.Basic.Gas.Volumes.*;

component ClosedVolume < BaseVolume
  % Closed Volume : 1.5 : fixed
  % Closed Homogeneous Gas Volume
  %
  %   (c) Klaus Schnitzlein - 28.08.2026
  %

  inputs(ExternalAccess = none)
    Vin = {0,'l'}; % V
  end

  annotations
    Vin : Side = top;
    Icon = './Volume.svg';
    UILayout = [...
      UIGroup('Options',volumeInputOutput,isothermalOperation,enable2ndPort),...
      UIGroup('Geometry',V0),...
      UIGroup('OperatingConditions',x0,p0,T0),...
      UIGroup('NominalValues',n_nom)];
    n : LoggingUnit = 'mol';
  end

  parameters
    volumeInputOutput = InOut.Off; % Volume Input/Output
    n_nom = {1,'mol'}; % Nominal Value for Number of Moles
  end
 
  parameters(Access = protected)
    n0 = p0*V0/(Port_A.R*T0);
  end

  if(volumeInputOutput == InOut.Output)
    annotations
      Vout : ExternalAccess = modify;
    end
  elseif(volumeInputOutput == InOut.Input)
    annotations
      V0 : ExternalAccess = none; 
      Vin : ExternalAccess = modify;
    end
  end

  variables(Access = protected)
    n = {value = row_x0*n0,imin = {0,'mol'},nominal = n_nom};
    p = {value = p0,priority = priority.high};
  end

  equations(Initial = true)
    n == row_x0*p*V/(z*R*T); 
  end
  
  if(isothermalOperation == OnOff.On)
    equations
      der(T) == 0;
    end
  else
    equations
      % sum(F.*H) + sum(F)*Hres + sum(n.*cp)*T.der == Phi + Q + V*der(p); % implicit
      sum(F.*(H-z*R*T)) + sum(F)*Hres + sum(n.*(cp-z*R))*der(T) == Phi + Q; % explicit
    end
  end

  intermediates
    V = if(volumeInputOutput == InOut.Input),
      max_noZC(Vin,{eps,'l'})
    else
      V0;
    end;
    nn = max_noZC(n,{eps,'mol'}); % avoid negative values
  end

  equations
    der(n) == F;
    p*V == z*R*T*sum(nn);
    Vout == V;
    Port_A.x == nn(1:N-1,1)/(sum(nn)+{eps,'mol'});
    Port_A.p == p;
  end
end
